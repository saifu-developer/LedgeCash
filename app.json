{
  "expo": {
    "name": "LedgeCash",
    "slug": "ledgecash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon.png",
    "scheme": "ledgecash",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-icon.png",
      "bundleIdentifier": "com.ledgecash.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F5",
        "foregroundImage": "./assets/images/logo-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ledgecash.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F5",
          "image": "./assets/images/logo-icon.png",
          "imageWidth": 288
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63b35991-01a4-4585-a0a0-fcf63a662a59"
      }
    }
  }
}
